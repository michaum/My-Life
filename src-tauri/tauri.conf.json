{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "My Life",
  "version": "1.1.0",
  "identifier": "com.michaum.mylife",
  "build": {
    "frontendDist": "../dist"
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:mylife.db"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "My Life",
        "width": 1200,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "url": "https://mylife.michaum.workers.dev",
        "center": true,
        "maximized": true,
        "decorations": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
