{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "My Life",
  "version": "1.1.4",
  "identifier": "com.michaum.mylife",
  "build": {
    "frontendDist": "../dist"
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:mylife.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxQkQ5Q0M5MUVFMjRDN0QKUldSOVRPSWV5Wnk5Z1Y2Yk91dlhWWTI4T1FEWU9QVHQvWjdXR0QvQWxpcDdFZEVRR0JkMXk5c0cK",
      "endpoints": [
        "https://github.com/michaum/My-Life/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "My Life",
        "width": 1200,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "url": "https://mylife.michaum.workers.dev",
        "center": true,
        "maximized": true,
        "decorations": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  }
}
