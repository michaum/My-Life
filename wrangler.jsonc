{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pinky-star",
  "workers_dev": false,
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pinky-star",
      "database_id": "ad5b76ce-fa13-4a38-aa16-4f2b4cbb744f"
    }
  ]
}
